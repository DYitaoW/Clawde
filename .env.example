# Local release-build settings. Copy to `.env` (gitignored) and fill in ONE
# notarization method. `npm run build:dmg` loads it automatically.
# Leave everything blank for an unsigned-for-distribution local test build.

# --- Option 1 (recommended): Keychain profile, no password in this file ---
# One-time: xcrun notarytool store-credentials "clawde-notary" \
#             --apple-id "you@example.com" --team-id "TEAMID" --password "app-specific-password"
APPLE_KEYCHAIN_PROFILE=

# --- Option 2: Apple ID + app-specific password (account.apple.com) ---
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# --- Option 3: App Store Connect API key ---
APPLE_API_KEY=          # path to AuthKey_XXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# --- Optional: upload to a draft GitHub release with `npm run release` ---
# Fine-grained token with "Contents: read and write" on the clawde repo.
GH_TOKEN=
