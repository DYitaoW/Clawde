{
  "name": "clawde",
  "version": "1.0.0",
  "description": "Clawde: macOS menu bar monitor for Claude and Antigravity usage limits",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --arm64",
    "build:dmg": "electron-builder --mac --arm64"
  },
  "keywords": [
    "claude",
    "menu-bar",
    "system-tray",
    "usage-monitor",
    "rate-limits",
    "antigravity"
  ],
  "author": "Yitao",
  "license": "MIT",
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.clawde.app",
    "productName": "Clawde",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "minimumSystemVersion": "12.0",
      "icon": "assets/icon-512.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DYitaoW/clawde.git"
  }
}
