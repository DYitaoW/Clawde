{
  "name": "clawde",
  "version": "1.1.1",
  "description": "Clawde: macOS menu bar monitor for Claude and Antigravity usage limits",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build:dmg",
    "build:dmg": "node scripts/build.js",
    "release": "node scripts/build.js --publish"
  },
  "keywords": [
    "claude",
    "menu-bar",
    "system-tray",
    "usage-monitor",
    "rate-limits",
    "antigravity"
  ],
  "author": "Yitao",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clawde.app",
    "productName": "Clawde",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "minimumSystemVersion": "12.0",
      "icon": "assets/icon-512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "DYitaoW",
        "repo": "clawde",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DYitaoW/clawde.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
